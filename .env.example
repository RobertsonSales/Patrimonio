# Gerenciador de Patrimônio (https://patrimonio-ten.vercel.app)
# Copie para .env.local apenas para testes locais com `vercel dev`.
# Em produção, cadastre em Vercel › Project › Settings › Environment Variables.
# NUNCA faça commit de valores reais.

# A MESMA URL /exec usada pelo Atualizador
APPS_SCRIPT_URL=https://script.google.com/macros/s/SEU_ID_DE_IMPLANTACAO/exec

# Leitura (/api/patrimonio): valor da propriedade READ_TOKEN do Apps Script
APPS_SCRIPT_TOKEN=cole-aqui-o-READ_TOKEN

# Gravação de clientes/unidades (/api/cadastro) — v2.2
# Token de ESCRITA: valor da propriedade API_TOKEN do Apps Script (o mesmo APPS_SCRIPT_TOKEN do Atualizador equipamentosonline)
APPS_SCRIPT_WRITE_TOKEN=cole-aqui-o-token-de-escrita
# Chave que o operador digita no modal "Clientes e Unidades" (use uma frase longa e aleatória)
CADASTRO_KEY=defina-uma-chave-forte-para-os-operadores
